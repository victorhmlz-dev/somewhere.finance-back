# API
PORT=3001
# Origin of the front, allowed by CORS
FRONT_URL=http://localhost:3000
# Address the API is reached at from outside; links to uploaded images use it.
# Defaults to http://localhost:<PORT>/api
PUBLIC_API_URL=
# Folder uploaded images are kept in (git ignores the default one)
UPLOAD_DIR=uploads
# Images each user can upload in 24 hours
UPLOAD_DAILY_LIMIT=30

# Requests per IP are limited (false only for tests). Behind a load balancer
# or a CDN, TRUST_PROXY is how many of them there are, so the client's real
# address is used; with the wrong number, clients can fake their address.
RATE_LIMIT_ENABLED=true
TRUST_PROXY=0

# PostgreSQL (docker-compose.yml reads the POSTGRES_* values)
POSTGRES_USER=somewhere
POSTGRES_PASSWORD=somewhere
POSTGRES_DB=somewhere_finance
POSTGRES_PORT=5433
DATABASE_URL=postgresql://somewhere:somewhere@localhost:5433/somewhere_finance
# The e2e tests use their own database, created on their first run: by
# default the one above with "_test" added to its name. They refuse to run
# on a database not named like that, or not on this machine.
# TEST_DATABASE_URL=postgresql://somewhere:somewhere@localhost:5433/somewhere_finance_test

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800

# Networks, of every family. A JSON list; each one says its family (evm or
# solana), its currency and, on EVM chains with launches, the Launchpad to
# read: key, family, chainId (EVM) or cluster (Solana), name, nativeCurrency
# { symbol, name, decimals }, rpcUrl, launchpad, startBlock, confirmations
# (blocks to wait before reading one; 0 only for a local chain) and
# logBlockRange. Empty for none. The older EVM_CHAINS, with nativeSymbol, is
# still read when CHAINS is not set. For local development,
# `npm run demo:local` in somewhere.finance-contracts prints this line.
CHAINS=
INDEXER_POLL_MS=4000
