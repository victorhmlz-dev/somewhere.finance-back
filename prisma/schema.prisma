generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// An EVM address is the same on Ethereum, BNB Chain and Robinhood Chain, so a
// wallet is identified by its address family rather than by a single chain.
enum WalletFamily {
  evm
  solana
}

model User {
  id             String   @id @default(uuid(7)) @db.Uuid
  // Stored in lowercase; uniqueness is therefore case-insensitive.
  handle         String   @unique @db.VarChar(15)
  name           String   @db.VarChar(50)
  bio            String   @default("") @db.VarChar(160)
  avatarUrl      String?  @map("avatar_url")
  verified       Boolean  @default(false)
  // Kept in step with the `follows` table, in the same transaction as each change.
  followingCount Int      @default(0) @map("following_count")
  followersCount Int      @default(0) @map("followers_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallets   Wallet[]
  // Rows where this user is the one following.
  following Follow[]   @relation("following")
  // Rows where this user is the one being followed.
  followers Follow[]   @relation("followers")
  posts     Post[]
  likes     Like[]
  reactions Reaction[]
  uploads   Upload[]

  pendingLaunchDetails PendingLaunchDetails[]
  reposts              Repost[]
  notifications        Notification[]         @relation("received")
  notificationsCaused  Notification[]         @relation("caused")

  @@map("users")
}

// A post, or a reply when `parentId` is set.
model Post {
  id       String  @id @default(uuid(7)) @db.Uuid
  authorId String  @map("author_id") @db.Uuid
  // Empty when the post is only an image.
  text     String  @db.VarChar(280)
  imageUrl String? @map("image_url")
  parentId String? @map("parent_id") @db.Uuid
  // Set when the post is a comment on a launch, or a reply in one of its
  // conversations. No foreign key: launches can be read from the chain again.
  launchId String? @map("launch_id") @db.Uuid

  // Kept in step with replies, reposts and likes, in the same transaction as
  // each change.
  repliesCount Int @default(0) @map("replies_count")
  repostsCount Int @default(0) @map("reposts_count")
  likesCount   Int @default(0) @map("likes_count")
  viewsCount   Int @default(0) @map("views_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // A deleted post keeps its row, emptied, so its replies still hang from it.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Post?          @relation("replies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       Post[]         @relation("replies")
  likes         Like[]
  reposts       Repost[]
  hashtags      PostHashtag[]
  notifications Notification[]
  reactions     Reaction[]

  @@index([authorId, id])
  @@index([parentId, id])
  @@index([launchId, id])
  @@map("posts")
}

model Like {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Repost {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("reposts")
}

model Wallet {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  family    WalletFamily
  // EVM: lowercase hex with 0x prefix. Solana: base58, case-sensitive.
  address   String       @db.VarChar(64)
  isPrimary Boolean      @default(false) @map("is_primary")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([family, address])
  @@index([userId])
  @@map("wallets")
}

// `follower` follows `following`. The id is a UUID v7, so ordering by it is
// ordering by the moment of the follow.
model Follow {
  id          String   @id @default(uuid(7)) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// One row per hashtag written in a post. Removed when the post is deleted.
model PostHashtag {
  postId String @map("post_id") @db.Uuid
  // Lowercase and without the `#`: what a hashtag is matched by.
  tag    String @db.VarChar(50)
  // As the author wrote it, without the `#`.
  label  String @db.VarChar(50)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, tag])
  @@index([tag, postId])
  @@map("post_hashtags")
}

enum NotificationType {
  like
  repost
  follow
  mention
  reply
  // Someone bought the recipient's token
  launch_purchase
  // The recipient bought a token; there is no actor
  purchase
  // Someone commented on the recipient's launch
  launch_comment
  // Someone reacted with an emoji to the recipient's post or launch
  reaction
}

/**
 * The emoji reactions there are, a fixed set.
 */
enum ReactionKind {
  rocket
  fire
  gem
  eyes
  joy
  thumbs_down
}

// One row per thing `actor` did that `recipient` should hear about. Rows are
// grouped when they are read ("Aria and 3 others liked your post"), and a row
// is removed when what caused it is undone or its post is deleted.
model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  recipientId  String           @map("recipient_id") @db.Uuid
  // Who did it. Null for a purchase notified to its own buyer, and for a
  // purchase made from a wallet with no Somewhere profile (see actorAddress).
  actorId      String?          @map("actor_id") @db.Uuid
  // The wallet that bought, when it belongs to no user.
  actorAddress String?          @map("actor_address") @db.VarChar(42)
  type         NotificationType
  // The post liked, reposted or reacted to, or the post that mentions,
  // replies or comments. Null for a follow and for a purchase.
  postId       String?          @map("post_id") @db.Uuid
  // The launch bought, commented on or reacted to. No foreign key: launches
  // can be read from the chain again.
  launchId     String?          @map("launch_id") @db.Uuid
  // For what an event on chain caused: "<chain>:<transaction>:<log index>".
  sourceKey    String?          @map("source_key") @db.VarChar(120)
  reaction     ReactionKind?
  // For a purchase: what was paid, in the smallest unit of the launch's
  // quote asset, and the tokens it bought.
  quoteAmount  Decimal?         @map("quote_amount") @db.Decimal(78, 0)
  tokenAmount  Decimal?         @map("token_amount") @db.Decimal(78, 0)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)

  recipient User  @relation("received", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("caused", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([recipientId, actorId, type, postId, launchId, reaction])
  // A notification caused by an event on chain is created once, however many
  // times the chain is read
  @@unique([recipientId, type, sourceKey])
  @@index([recipientId, id])
  @@index([postId])
  @@index([launchId])
  @@map("notifications")
}

/**
 * An emoji reaction of a user to a post or to a launch, one of each kind.
 */
model Reaction {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  kind      ReactionKind
  // Exactly one of the two is set. The launch has no foreign key: launches
  // can be read from the chain again.
  postId    String?      @map("post_id") @db.Uuid
  launchId  String?      @map("launch_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, kind])
  @@unique([userId, launchId, kind])
  @@index([postId])
  @@index([launchId])
  @@map("reactions")
}

/**
 * The description and image a creator sent for a launch the indexer has not
 * read yet, by the transaction that creates it. Once the launch is indexed,
 * the ones sent by the user who holds the creator's wallet are applied, and
 * all of them are deleted.
 */
/**
 * What the creator wrote about a launch: not on chain, set once, before the
 * sale starts, and never changed. Kept apart from the launch, by its id, so
 * it survives the launch being read from the chain again.
 */
model LaunchProfile {
  launchId     String   @id @map("launch_id") @db.Uuid
  description  String   @default("") @db.VarChar(280)
  // A file uploaded to this API.
  imageUrl     String?  @map("image_url")
  detailsSetAt DateTime @default(now()) @map("details_set_at") @db.Timestamptz(3)

  @@map("launch_profiles")
}

model PendingLaunchDetails {
  id          String   @id @default(uuid(7)) @db.Uuid
  chainKey    String   @map("chain_key") @db.VarChar(32)
  txHash      String   @map("tx_hash") @db.VarChar(66)
  userId      String   @map("user_id") @db.Uuid
  description String   @db.VarChar(280)
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Anyone can claim any transaction; only the user who holds the
  // creator's wallet gets their details applied.
  @@unique([chainKey, txHash, userId])
  @@map("pending_launch_details")
}

// One row per sign-in attempt: the exact message the wallet has to sign.
// A challenge is valid once and only until it expires.
model AuthChallenge {
  id        String       @id @default(uuid(7)) @db.Uuid
  nonce     String       @unique @db.VarChar(96)
  family    WalletFamily
  address   String       @db.VarChar(64)
  message   String
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([family, address])
  @@map("auth_challenges")
}

// ---------------------------------------------------------------------------
// Launchpad. Everything below is a copy of what the contracts of
// somewhere.finance-contracts hold on chain, built by reading their events.
// The chain is the source of truth; these tables exist to list and filter.
// Amounts are in the smallest unit (wei) and can be as large as a uint256.
// ---------------------------------------------------------------------------

// One row per launch created through a Launchpad contract.
/**
 * A launch as read from the chain. Everything here is a copy of the chain,
 * and can be deleted and read again: what people add about a launch (its
 * description and image, comments, reactions, notifications) lives in other
 * tables that point to its id, and the id comes out the same every time the
 * launch is read (see launch-id.ts), so they find it again.
 */
model Launch {
  // Derived from the chain: chain, contract, number and block time. Not
  // random, so reading the chain again gives every launch the same id.
  id               String @id @db.Uuid
  // Which configured chain it lives on, e.g. "ethereum" (see EVM_CHAINS).
  chainKey         String @map("chain_key") @db.VarChar(32)
  // The Launchpad contract that created it, in lowercase.
  launchpad        String @db.VarChar(42)
  // Number of the launch inside its Launchpad contract.
  launchId         Int    @map("launch_id")
  // Version of that contract: 2 sells for the chain's currency, 3 for any
  // asset the Launchpad allows.
  launchpadVersion Int    @default(2) @map("launchpad_version") @db.SmallInt
  // Verification tier buyers need. Zero for anyone.
  requiredTier     Int    @default(0) @map("required_tier") @db.SmallInt

  // What the token is sold for and paired with: the chain's own currency, a
  // stablecoin, a tokenized stock… Every amount of the sale is in it.
  quoteAssetId  String @map("quote_asset_id") @db.Uuid
  // Decimals of the token launched.
  tokenDecimals Int    @default(18) @map("token_decimals")

  // Addresses are stored in lowercase.
  tokenAddress   String @map("token_address") @db.VarChar(42)
  saleAddress    String @map("sale_address") @db.VarChar(42)
  vestingAddress String @map("vesting_address") @db.VarChar(42)
  creatorAddress String @map("creator_address") @db.VarChar(42)

  // Fixed when the launch is created.
  name                 String   @db.VarChar(100)
  symbol               String   @db.VarChar(32)
  totalSupply          Decimal  @map("total_supply") @db.Decimal(78, 0)
  tokensForSale        Decimal  @map("tokens_for_sale") @db.Decimal(78, 0)
  creatorAllocation    Decimal  @map("creator_allocation") @db.Decimal(78, 0)
  softCap              Decimal  @map("soft_cap") @db.Decimal(78, 0)
  hardCap              Decimal  @map("hard_cap") @db.Decimal(78, 0)
  minContribution      Decimal  @map("min_contribution") @db.Decimal(78, 0)
  maxContribution      Decimal  @map("max_contribution") @db.Decimal(78, 0)
  startTime            DateTime @map("start_time") @db.Timestamptz(0)
  endTime              DateTime @map("end_time") @db.Timestamptz(0)
  creatorAllocationBps Int      @map("creator_allocation_bps")
  liquidityBps         Int      @map("liquidity_bps")
  feeBps               Int      @map("fee_bps")
  vestingTranches      Int      @map("vesting_tranches")

  // Kept up to date from the events of the sale.
  totalRaised      Decimal   @default(0) @map("total_raised") @db.Decimal(78, 0)
  contributorCount Int       @default(0) @map("contributor_count")
  hardCapReachedAt DateTime? @map("hard_cap_reached_at") @db.Timestamptz(0)

  // Set when the sale is finalized.
  finalizedAt     DateTime? @map("finalized_at") @db.Timestamptz(0)
  pairAddress     String?   @map("pair_address") @db.VarChar(42)
  liquidityQuote  Decimal?  @map("liquidity_quote") @db.Decimal(78, 0)
  liquidityTokens Decimal?  @map("liquidity_tokens") @db.Decimal(78, 0)
  creatorQuote    Decimal?  @map("creator_quote") @db.Decimal(78, 0)
  fee             Decimal?  @db.Decimal(78, 0)
  tokensBurned    Decimal?  @map("tokens_burned") @db.Decimal(78, 0)
  feeCollectedAt  DateTime? @map("fee_collected_at") @db.Timestamptz(0)

  // Set when the creator cancels the sale before it starts. Every token was
  // burned; the amount is in tokensBurned.
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(0)

  // What the creator's vesting has paid out so far.
  vestingReleasedQuote  Decimal @default(0) @map("vesting_released_quote") @db.Decimal(78, 0)
  vestingReleasedTokens Decimal @default(0) @map("vesting_released_tokens") @db.Decimal(78, 0)

  // Where and when the launch was created on chain.
  createdAt     DateTime @map("created_at") @db.Timestamptz(0)
  createdBlock  BigInt   @map("created_block")
  createdTxHash String   @map("created_tx_hash") @db.VarChar(66)

  contributions LaunchContribution[]
  quoteAsset    Asset                @relation(fields: [quoteAssetId], references: [id], onDelete: Restrict)

  @@unique([chainKey, launchpad, launchId])
  @@index([chainKey, saleAddress])
  @@index([chainKey, vestingAddress])
  @@index([creatorAddress])
  @@map("launches")
}

// What one address has put into one launch, and what it got back.
model LaunchContribution {
  id          String  @id @default(uuid(7)) @db.Uuid
  launchRowId String  @map("launch_row_id") @db.Uuid
  contributor String  @db.VarChar(42)
  // Everything the address contributed. Not reduced by a claim or a refund.
  amount      Decimal @db.Decimal(78, 0)

  claimedTokens  Decimal?  @map("claimed_tokens") @db.Decimal(78, 0)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(0)
  refundedAmount Decimal?  @map("refunded_amount") @db.Decimal(78, 0)
  refundedAt     DateTime? @map("refunded_at") @db.Timestamptz(0)

  firstContributedAt DateTime @map("first_contributed_at") @db.Timestamptz(0)

  launch Launch @relation(fields: [launchRowId], references: [id], onDelete: Cascade)

  @@unique([launchRowId, contributor])
  @@index([contributor])
  @@map("launch_contributions")
}

// Every contract event the indexer has processed, exactly once. It is the
// evidence behind the two tables above: what happened, where, and when.
model ChainEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  chainKey    String   @map("chain_key") @db.VarChar(32)
  blockNumber BigInt   @map("block_number")
  blockHash   String   @map("block_hash") @db.VarChar(66)
  blockTime   DateTime @map("block_time") @db.Timestamptz(0)
  txHash      String   @map("tx_hash") @db.VarChar(66)
  logIndex    Int      @map("log_index")
  // The contract that emitted it, in lowercase.
  address     String   @db.VarChar(42)
  name        String   @db.VarChar(64)
  // Decoded arguments, with numbers as strings.
  args        Json

  @@unique([chainKey, txHash, logIndex])
  @@index([chainKey, address])
  @@map("chain_events")
}

// How far the indexer has read each chain.
// How far the indexer has read each Launchpad contract of each chain.
model ChainCursor {
  chainKey  String   @map("chain_key") @db.VarChar(32)
  // The Launchpad contract read, in lowercase.
  launchpad String   @db.VarChar(42)
  // Last block fully processed.
  lastBlock BigInt   @map("last_block")
  lastHash  String   @map("last_hash") @db.VarChar(66)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([chainKey, launchpad])
  @@map("chain_cursors")
}

// The assets a v3 Launchpad lets new launches be paired with, as its
// QuoteAssetUpdated events say. A row stays when an asset stops being
// allowed, with allowed = false: launches already paired with it keep it.
model LaunchpadQuoteAsset {
  chainKey   String   @map("chain_key") @db.VarChar(32)
  launchpad  String   @db.VarChar(42)
  assetId    String   @map("asset_id") @db.Uuid
  allowed    Boolean
  // Smallest soft cap a launch paired with it can have, in its smallest unit.
  minSoftCap Decimal  @map("min_soft_cap") @db.Decimal(78, 0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([chainKey, launchpad, assetId])
  @@map("launchpad_quote_assets")
}

/**
 * An image a user uploaded. Counts toward their daily quota, and says who
 * uploaded each file, for moderation and for removing files nobody uses.
 */
model Upload {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // Name of the stored file: the SHA-256 of its content and its extension.
  fileName  String   @map("file_name") @db.VarChar(80)
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([fileName])
  @@map("uploads")
}

/**
 * What an asset is, for showing it and for the rules that apply to it.
 */
enum AssetKind {
  // The currency a chain pays fees in: ETH, BNB, SOL…
  native
  crypto
  stablecoin
  // A tokenized share, like the Robinhood stock tokens
  stock
  // Any other real-world asset: gold, bonds, funds…
  rwa
}

/**
 * An asset on one chain: a currency, a token, a tokenized stock. Amounts in
 * the API are integers in the smallest unit of their asset, and its decimals
 * say how to read them; nothing assumes 18 decimals or one currency.
 */
model Asset {
  id        String    @id @default(uuid(7)) @db.Uuid
  chainKey  String    @map("chain_key") @db.VarChar(32)
  // "native" for the chain's own currency. Otherwise the token's address:
  // in lowercase on EVM chains, as it is (base58) for a Solana mint.
  address   String    @db.VarChar(64)
  symbol    String    @db.VarChar(32)
  name      String    @db.VarChar(100)
  decimals  Int
  kind      AssetKind
  // Who issues it, for stocks and other real-world assets.
  issuer    String?   @db.VarChar(100)
  // Whether the issuer can freeze, pause or take balances, as with USDC or
  // the Robinhood stock tokens. Users are warned before buying with it.
  canFreeze Boolean   @default(false) @map("can_freeze")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  launches  Launch[]
  allowedOn LaunchpadQuoteAsset[]

  @@unique([chainKey, address])
  @@map("assets")
}
