generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// An EVM address is the same on Ethereum, BNB Chain and Robinhood Chain, so a
// wallet is identified by its address family rather than by a single chain.
enum WalletFamily {
  evm
  solana
}

model User {
  id             String   @id @default(uuid(7)) @db.Uuid
  // Stored in lowercase; uniqueness is therefore case-insensitive.
  handle         String   @unique @db.VarChar(15)
  name           String   @db.VarChar(50)
  bio            String   @default("") @db.VarChar(160)
  avatarUrl      String?  @map("avatar_url")
  verified       Boolean  @default(false)
  // Kept in step with the `follows` table, in the same transaction as each change.
  followingCount Int      @default(0) @map("following_count")
  followersCount Int      @default(0) @map("followers_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallets             Wallet[]
  // Rows where this user is the one following.
  following           Follow[]       @relation("following")
  // Rows where this user is the one being followed.
  followers           Follow[]       @relation("followers")
  posts               Post[]
  likes               Like[]
  reposts             Repost[]
  notifications       Notification[] @relation("received")
  notificationsCaused Notification[] @relation("caused")

  @@map("users")
}

// A post, or a reply when `parentId` is set.
model Post {
  id       String  @id @default(uuid(7)) @db.Uuid
  authorId String  @map("author_id") @db.Uuid
  // Empty when the post is only an image.
  text     String  @db.VarChar(280)
  imageUrl String? @map("image_url")
  parentId String? @map("parent_id") @db.Uuid

  // Kept in step with replies, reposts and likes, in the same transaction as
  // each change.
  repliesCount Int @default(0) @map("replies_count")
  repostsCount Int @default(0) @map("reposts_count")
  likesCount   Int @default(0) @map("likes_count")
  viewsCount   Int @default(0) @map("views_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // A deleted post keeps its row, emptied, so its replies still hang from it.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Post?          @relation("replies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       Post[]         @relation("replies")
  likes         Like[]
  reposts       Repost[]
  hashtags      PostHashtag[]
  notifications Notification[]

  @@index([authorId, id])
  @@index([parentId, id])
  @@map("posts")
}

model Like {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Repost {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("reposts")
}

model Wallet {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  family    WalletFamily
  // EVM: lowercase hex with 0x prefix. Solana: base58, case-sensitive.
  address   String       @db.VarChar(64)
  isPrimary Boolean      @default(false) @map("is_primary")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([family, address])
  @@index([userId])
  @@map("wallets")
}

// `follower` follows `following`. The id is a UUID v7, so ordering by it is
// ordering by the moment of the follow.
model Follow {
  id          String   @id @default(uuid(7)) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// One row per hashtag written in a post. Removed when the post is deleted.
model PostHashtag {
  postId String @map("post_id") @db.Uuid
  // Lowercase and without the `#`: what a hashtag is matched by.
  tag    String @db.VarChar(50)
  // As the author wrote it, without the `#`.
  label  String @db.VarChar(50)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, tag])
  @@index([tag, postId])
  @@map("post_hashtags")
}

enum NotificationType {
  like
  repost
  follow
  mention
  reply
}

// One row per thing `actor` did that `recipient` should hear about. Rows are
// grouped when they are read ("Aria and 3 others liked your post"), and a row
// is removed when what caused it is undone or its post is deleted.
model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String           @map("actor_id") @db.Uuid
  type        NotificationType
  // The post liked or reposted, or the post that mentions or replies.
  // Null for a follow.
  postId      String?          @map("post_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)

  recipient User  @relation("received", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User  @relation("caused", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([recipientId, actorId, type, postId])
  @@index([recipientId, id])
  @@index([postId])
  @@map("notifications")
}

// One row per sign-in attempt: the exact message the wallet has to sign.
// A challenge is valid once and only until it expires.
model AuthChallenge {
  id        String       @id @default(uuid(7)) @db.Uuid
  nonce     String       @unique @db.VarChar(96)
  family    WalletFamily
  address   String       @db.VarChar(64)
  message   String
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([family, address])
  @@map("auth_challenges")
}

// ---------------------------------------------------------------------------
// Launchpad. Everything below is a copy of what the contracts of
// somewhere.finance-contracts hold on chain, built by reading their events.
// The chain is the source of truth; these tables exist to list and filter.
// Amounts are in the smallest unit (wei) and can be as large as a uint256.
// ---------------------------------------------------------------------------

// One row per launch created through a Launchpad contract.
model Launch {
  id       String @id @default(uuid(7)) @db.Uuid
  // Which configured chain it lives on, e.g. "ethereum" (see EVM_CHAINS).
  chainKey String @map("chain_key") @db.VarChar(32)
  // Number of the launch inside its Launchpad contract.
  launchId Int    @map("launch_id")

  // Addresses are stored in lowercase.
  tokenAddress   String @map("token_address") @db.VarChar(42)
  saleAddress    String @map("sale_address") @db.VarChar(42)
  vestingAddress String @map("vesting_address") @db.VarChar(42)
  creatorAddress String @map("creator_address") @db.VarChar(42)

  // Fixed when the launch is created.
  name                 String   @db.VarChar(100)
  symbol               String   @db.VarChar(32)
  totalSupply          Decimal  @map("total_supply") @db.Decimal(78, 0)
  tokensForSale        Decimal  @map("tokens_for_sale") @db.Decimal(78, 0)
  creatorAllocation    Decimal  @map("creator_allocation") @db.Decimal(78, 0)
  softCap              Decimal  @map("soft_cap") @db.Decimal(78, 0)
  hardCap              Decimal  @map("hard_cap") @db.Decimal(78, 0)
  minContribution      Decimal  @map("min_contribution") @db.Decimal(78, 0)
  maxContribution      Decimal  @map("max_contribution") @db.Decimal(78, 0)
  startTime            DateTime @map("start_time") @db.Timestamptz(0)
  endTime              DateTime @map("end_time") @db.Timestamptz(0)
  creatorAllocationBps Int      @map("creator_allocation_bps")
  liquidityBps         Int      @map("liquidity_bps")
  feeBps               Int      @map("fee_bps")
  vestingTranches      Int      @map("vesting_tranches")

  // Kept up to date from the events of the sale.
  totalRaised      Decimal   @default(0) @map("total_raised") @db.Decimal(78, 0)
  contributorCount Int       @default(0) @map("contributor_count")
  hardCapReachedAt DateTime? @map("hard_cap_reached_at") @db.Timestamptz(0)

  // Set when the sale is finalized.
  finalizedAt     DateTime? @map("finalized_at") @db.Timestamptz(0)
  pairAddress     String?   @map("pair_address") @db.VarChar(42)
  liquidityNative Decimal?  @map("liquidity_native") @db.Decimal(78, 0)
  liquidityTokens Decimal?  @map("liquidity_tokens") @db.Decimal(78, 0)
  creatorNative   Decimal?  @map("creator_native") @db.Decimal(78, 0)
  fee             Decimal?  @db.Decimal(78, 0)
  tokensBurned    Decimal?  @map("tokens_burned") @db.Decimal(78, 0)
  feeCollectedAt  DateTime? @map("fee_collected_at") @db.Timestamptz(0)

  // Set when the creator cancels the sale before it starts. Every token was
  // burned; the amount is in tokensBurned.
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(0)

  // What the creator's vesting has paid out so far.
  vestingReleasedNative Decimal @default(0) @map("vesting_released_native") @db.Decimal(78, 0)
  vestingReleasedTokens Decimal @default(0) @map("vesting_released_tokens") @db.Decimal(78, 0)

  // Written by the creator through the API; not on chain. The image can be
  // set once and never changed; it must be a file uploaded to this API.
  description String  @default("") @db.VarChar(280)
  imageUrl    String? @map("image_url")

  // Where and when the launch was created on chain.
  createdAt     DateTime @map("created_at") @db.Timestamptz(0)
  createdBlock  Int      @map("created_block")
  createdTxHash String   @map("created_tx_hash") @db.VarChar(66)

  contributions LaunchContribution[]

  @@unique([chainKey, launchId])
  @@index([chainKey, saleAddress])
  @@index([chainKey, vestingAddress])
  @@index([creatorAddress])
  @@map("launches")
}

// What one address has put into one launch, and what it got back.
model LaunchContribution {
  id          String  @id @default(uuid(7)) @db.Uuid
  launchRowId String  @map("launch_row_id") @db.Uuid
  contributor String  @db.VarChar(42)
  // Everything the address contributed. Not reduced by a claim or a refund.
  amount      Decimal @db.Decimal(78, 0)

  claimedTokens  Decimal?  @map("claimed_tokens") @db.Decimal(78, 0)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(0)
  refundedAmount Decimal?  @map("refunded_amount") @db.Decimal(78, 0)
  refundedAt     DateTime? @map("refunded_at") @db.Timestamptz(0)

  firstContributedAt DateTime @map("first_contributed_at") @db.Timestamptz(0)

  launch Launch @relation(fields: [launchRowId], references: [id], onDelete: Cascade)

  @@unique([launchRowId, contributor])
  @@index([contributor])
  @@map("launch_contributions")
}

// Every contract event the indexer has processed, exactly once. It is the
// evidence behind the two tables above: what happened, where, and when.
model ChainEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  chainKey    String   @map("chain_key") @db.VarChar(32)
  blockNumber Int      @map("block_number")
  blockHash   String   @map("block_hash") @db.VarChar(66)
  blockTime   DateTime @map("block_time") @db.Timestamptz(0)
  txHash      String   @map("tx_hash") @db.VarChar(66)
  logIndex    Int      @map("log_index")
  // The contract that emitted it, in lowercase.
  address     String   @db.VarChar(42)
  name        String   @db.VarChar(64)
  // Decoded arguments, with numbers as strings.
  args        Json

  @@unique([chainKey, txHash, logIndex])
  @@index([chainKey, address])
  @@map("chain_events")
}

// How far the indexer has read each chain.
model ChainCursor {
  chainKey  String   @id @map("chain_key") @db.VarChar(32)
  // Last block fully processed.
  lastBlock Int      @map("last_block")
  lastHash  String   @map("last_hash") @db.VarChar(66)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("chain_cursors")
}
